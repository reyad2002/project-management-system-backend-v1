{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "crons": [
    { "path": "/api/internal/cron/meeting-reminders", "schedule": "0 7 * * *" },
    { "path": "/api/internal/cron/recurring-billing", "schedule": "0 6 * * *" }
  ]
}
